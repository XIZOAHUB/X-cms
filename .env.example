# AuroraCMS Pro Environment Variables   // Available
# Do NOT commit your actual .env file to version control

# GitHub OAuth App Settings (for GitHub Login)
# 1. Go to GitHub -> Settings -> Developer Settings -> OAuth Apps
# 2. Authorization callback URL: http://localhost:5173/api/auth/callback (or your production URL)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Session Secret (used for signing JWTs locally - in Cloudflare Pages it will be stored in KV/secrets)
JWT_SECRET=super_secret_local_dev_key_change_in_prod

# Gemini API for AI Assistant Features
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare settings (used by backend API proxy)
# In production, these should be securely stored in Cloudflare Secrets or KV
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id
CLOUDFLARE_API_TOKEN=your_cf_api_token

  
